local function shakeElement(el, intensity, dur)
    local base = el.Position
    task.spawn(function()
        local start = tick()
        while tick() - start < dur do
            if not el.Parent then return end
            local t = (tick() - start) / dur
            local decay = (1 - t) * (1 - t)
            local x = math.sin(tick() * 55) * intensity * decay
            local y = math.cos(tick() * 48) * intensity * decay * 0.35
            el.Position = UDim2.new(base.X.Scale, math.floor(base.X.Offset + x), base.Y.Scale, math.floor(base.Y.Offset + y))
            RunService.RenderStepped:Wait()
        end
        if el.Parent then el.Position = base end
    end)
end

