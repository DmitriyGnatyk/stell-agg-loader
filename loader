        lb.TextSize = 9
        lb.TextColor3 = (code == currentLang) and Color3.new(1,1,1) or C.muted
        lb.Size = UDim2.new(0, 53, 0, 20)
        lb.BackgroundColor3 = (code == currentLang) and C.accent or C.surface3
        lb.BackgroundTransparency = (code == currentLang) and 0 or 0.5
        lb.BorderSizePixel = 0
        lb.AutoButtonColor = false
        lb.ZIndex = 15
        corner(lb, 6)
        if code == currentLang then grad(lb, C.accent, C.accent2, 45) end
        lb.MouseEnter:Connect(function()
            if code ~= currentLang then
                hoverSound()
                tw(lb, 0.15, {BackgroundTransparency = 0, BackgroundColor3 = C.surface3, TextColor3 = C.text})
            end
        end)
        lb.MouseLeave:Connect(function()
            if code ~= currentLang then
                tw(lb, 0.15, {BackgroundTransparency = 0.5, BackgroundColor3 = C.surface3, TextColor3 = C.muted})
            end
        end)
        lb.MouseButton1Click:Connect(function()
            if code == currentLang then return end
            clickSound()
            currentLang = code
            saveLang(code)
            cleanup(); gui:Destroy()
            buildUI(onActivated)
        end)
    end

    -- FOOTER
    local footer = Instance.new("TextLabel", content)
    footer.Text = T.footer
    footer.Font = Enum.Font.Gotham
    footer.TextSize = 9
    footer.TextColor3 = C.mutedDark
    footer.Size = UDim2.new(1, -44, 0, 14)
    footer.Position = UDim2.new(0, 22, 0, CARD_H - 18)
    footer.BackgroundTransparency = 1
    footer.TextXAlignment = Enum.TextXAlignment.Center
    footer.ZIndex = 14

    -- COVER
    local cover = Instance.new("Frame", card)
    cover.Size = UDim2.new(1, 0, 1, 0)
    cover.BackgroundColor3 = Color3.fromRGB(14, 15, 22)
    cover.BackgroundTransparency = 0
    cover.BorderSizePixel = 0
    cover.ZIndex = 50
    corner(cover, 20)

    local errFlash = Instance.new("Frame", card)
    errFlash.Size = UDim2.new(1, 0, 1, 0)
    errFlash.BackgroundColor3 = C.red
    errFlash.BackgroundTransparency = 1
    errFlash.BorderSizePixel = 0
    errFlash.ZIndex = 55
    corner(errFlash, 20)

    local okFlash = Instance.new("Frame", card)
    okFlash.Size = UDim2.new(1, 0, 1, 0)
    okFlash.BackgroundColor3 = C.green
    okFlash.BackgroundTransparency = 1
    okFlash.BorderSizePixel = 0
    okFlash.ZIndex = 55
    corner(okFlash, 20)

    -- ENTRANCE
    tw(card, 0.85, {Size = UDim2.new(0, CARD_W, 0, CARD_H)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    task.delay(0.6, function()
        tw(cover, 0.5, {BackgroundTransparency = 1}, Enum.EasingStyle.Quint)
        task.delay(0.6, function() if cover.Parent then cover:Destroy() end end)
    end)

    -- STATE
    local step1Done = false
    local step2Done = false
    local step3Done = false
    local checking = false

    getBtn.MouseButton1Click:Connect(function()
        clickSound()
        pcall(function() setclipboard(KEY_LINK_URL) end)
        pcall(function() if typeof(openbrowser)=="function" then openbrowser(KEY_LINK_URL) end end)
        local old = getBtn.Text
        getBtn.Text = "OK - " .. T.copied
        task.delay(2, function() if getBtn.Parent then getBtn.Text = old end end)
        if not step1Done then
            step1Done = true
            markStepDone(s1)
            tw(timelineFill, 0.7, {Size = UDim2.new(1, 0, 0, fillStep1)}, Enum.EasingStyle.Quint)
        end
    end)

    input:GetPropertyChangedSignal("Text"):Connect(function()
        local t = input.Text:gsub("%s+", "")
        local valid = isValidKeyFormat(t)
        updateKeyPreview()
        if valid and not step2Done then
            step2Done = true
            markStepDone(s2)
            tw(timelineFill, 0.7, {Size = UDim2.new(1, 0, 0, fillStep2)}, Enum.EasingStyle.Quint)
        elseif not valid and step2Done and not step3Done and not checking then
            step2Done = false
            resetStep(s2)
            tw(timelineFill, 0.5, {Size = UDim2.new(1, 0, 0, step1Done and fillStep1 or 0)}, Enum.EasingStyle.Quint)
        end
    end)

    -- CONFETTI
    local function spawnConfetti()
        for i = 1, 20 do
            local p = Instance.new("Frame", content)
            local sz = math.random(4, 7)
            p.Size = UDim2.new(0, sz, 0, sz)
            p.Position = UDim2.new(0.5, 0, 0, actY + 25)
            p.BackgroundColor3 = (i % 3 == 0) and C.green or ((i % 3 == 1) and C.accent or C.accent2)
            p.BorderSizePixel = 0
            p.ZIndex = 30
            cornerPct(p, 1)
            local angle = (i / 20) * math.pi * 2 + math.random() * 0.3
            local dist = math.random(80, 220)
            local tx = math.cos(angle) * dist
            local peakY = -math.random(60, 140)
            tw(p, 0.45, {Position = UDim2.new(0.5, tx * 0.7, 0, actY + 25 + peakY)}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            task.delay(0.45, function()
                if not p.Parent then return end
                tw(p, 1.1, {Position = UDim2.new(0.5, tx, 0, actY + 260), Rotation = math.random(-360, 360), BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            end)
            task.delay(1.6, function() if p.Parent then p:Destroy() end end)
        end
    end

    local function doActivate()
        if checking then return end
        local key = input.Text:gsub("%s+", "")
        if key == "" then
            setStatus(T.no_key, "error")
            errorSound()
            shakeElement(card, 12, 0.4)
            errFlash.BackgroundTransparency = 0.75
            tw(errFlash, 0.4, {BackgroundTransparency = 1})
            return
        end

        clickSound()
        checking = true
        actBtn.Interactable = false
        actBtn.Text = "..."
        setStatus(T.status_checking, "checking")

        task.spawn(function()
            local hwid = getHWID()
            local url = SERVER_URL .. "/validate?key=" .. key .. "&hwid=" .. hwid
            local _, body = httpGet(url)
            local ok, data = pcall(HttpService.JSONDecode, HttpService, body or "{}")

            if not ok or not data or not data.valid then
                local reason = data and data.reason or "connection_error"
                local msg = T.err_invalid
                if reason == "hwid_mismatch" then msg = T.err_hwid
                elseif type(reason)=="string" and reason:find("^banned") then msg = T.err_banned
                elseif reason == "inactive" then msg = T.err_inactive
                elseif reason == "expired" then msg = T.err_expired
                elseif reason == "rate_limited" then msg = T.err_rate
                elseif reason == "connection_error" or (type(reason)=="string" and reason:find("Connection")) then msg = T.err_net end

                setStatus(msg, "error")
                errorSound()
                shakeElement(card, 14, 0.5)
                errFlash.BackgroundTransparency = 0.75
                tw(errFlash, 0.5, {BackgroundTransparency = 1})
                actBtn.Interactable = true
                actBtn.Text = T.activate
                checking = false
                return
            end

            saveKey(key)
            setStatus(T.status_success, "success")
            successSound()
            actBtn.Text = "OK - " .. T.status_success
            tw(actBtn, 0.3, {BackgroundColor3 = C.green})

            if not step2Done then
                step2Done = true
                markStepDone(s2, true)
            end
            if not step3Done then
                step3Done = true
                markStepDone(s3)
                tw(timelineFill, 0.9, {Size = UDim2.new(1, 0, 0, fillStep3)}, Enum.EasingStyle.Quint)
            end

            okFlash.BackgroundTransparency = 0.6
            tw(okFlash, 0.6, {BackgroundTransparency = 1})

            spawnConfetti()

            task.wait(1.3)
            checking = false

            local fadeCover = Instance.new("Frame", card)
            fadeCover.Size = UDim2.new(1, 0, 1, 0)
            fadeCover.BackgroundColor3 = Color3.fromRGB(14, 15, 22)
            fadeCover.BackgroundTransparency = 1
            fadeCover.BorderSizePixel = 0
            fadeCover.ZIndex = 50
            corner(fadeCover, 20)
            tw(fadeCover, 0.35, {BackgroundTransparency = 0}, Enum.EasingStyle.Quint)
            task.wait(0.4)

            tw(card, 0.4, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            tw(shadow1, 0.4, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
            task.wait(0.5)

            cleanup()
            gui:Destroy()
            if onActivated then onActivated(key) end
        end)
    end

    actBtn.MouseButton1Click:Connect(doActivate)

    if not IS_MOBILE then
        track(UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.Escape then
                closeUI()
            end
        end))
    end

    input.Focused:Connect(function()
        tw(inputStroke, 0.25, {Color = C.accent, Transparency = 0})
        tw(inputWrap, 0.25, {BackgroundColor3 = C.surface3})
        if not step2Done then
            tw(s2.stroke, 0.25, {Color = C.accent, Transparency = 0})
            tw(s2.num, 0.25, {TextColor3 = C.accent})
        end
    end)
    input.FocusLost:Connect(function(enter)
        tw(inputStroke, 0.25, {Color = C.border, Transparency = 0})
        tw(inputWrap, 0.25, {BackgroundColor3 = C.surface2})
        if not step2Done then
            tw(s2.stroke, 0.25, {Color = C.border, Transparency = 0})
            tw(s2.num, 0.25, {TextColor3 = C.muted})
        end
        if enter and not IS_MOBILE then doActivate() end
    end)

    if not IS_MOBILE then
        track(UserInputService.InputBegan:Connect(function(inp, gp)
            if gp then return end
            if inp.KeyCode == Enum.KeyCode.Return then
                if not input:IsFocused() then
                    doActivate()
                end
            end
        end))
    end

    if not IS_MOBILE then
        task.delay(1.2, function()
            if input.Parent then
                pcall(function() input:CaptureFocus() end)
            end
        end)
    end
end

-- ═══════════ ENTRY POINT ═══════════
local existingKey = findExistingKey()
local function start(key)
    if not launchMain(key) then warn("[SXNT] Launch failed") end
end

if existingKey then
    start(existingKey)
else
    buildUI(function(k) start(k) end)
end
