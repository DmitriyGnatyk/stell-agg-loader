local function attachRipple(btn, color)
    btn.ClipsDescendants = true
    btn.MouseButton1Down:Connect(function()
        local mouse = UserInputService:GetMouseLocation()
        local ap = btn.AbsolutePosition
        local relX, relY = mouse.X - ap.X, mouse.Y - ap.Y
        if relX < 0 or relY < 0 or relX > btn.AbsoluteSize.X or relY > btn.AbsoluteSize.Y then
            relX, relY = btn.AbsoluteSize.X / 2, btn.AbsoluteSize.Y / 2
        end
        local r = Instance.new("Frame", btn)
        r.AnchorPoint = Vector2.new(0.5, 0.5)
        r.Position = UDim2.new(0, relX, 0, relY)
        r.Size = UDim2.new(0, 0, 0, 0)
        r.BackgroundColor3 = color or Color3.new(1,1,1)
        r.BackgroundTransparency = 0.75
        r.BorderSizePixel = 0
        r.ZIndex = btn.ZIndex + 1
        cornerPct(r, 1)
        local c1 = math.sqrt(relX^2 + relY^2)
        local c2 = math.sqrt((btn.AbsoluteSize.X - relX)^2 + relY^2)
        local c3 = math.sqrt(relX^2 + (btn.AbsoluteSize.Y - relY)^2)
        local c4 = math.sqrt((btn.AbsoluteSize.X - relX)^2 + (btn.AbsoluteSize.Y - relY)^2)
        local maxD = math.max(c1, math.max(c2, math.max(c3, c4))) * 2
        tw(r, 0.55, {Size = UDim2.new(0, maxD, 0, maxD), BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        task.delay(0.6, function() if r.Parent then r:Destroy() end end)
    end)
end

