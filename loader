        local _, body = httpGet(SERVER_URL .. "/validate?key=" .. savedKey .. "&hwid=" .. hwid)
        local ok, data = pcall(HttpService.JSONDecode, HttpService, body or "{}")
        if ok and data and data.valid then
            return savedKey
        end
    end

    local hwid = getHWID()
    local _, body = httpGet(SERVER_URL .. "/hwid-lookup?hwid=" .. hwid)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, body or "{}")
    if ok and data and data.found and data.key then
        saveKey(data.key)
        return data.key
    end

    if savedKey and savedKey ~= "" then
        delKey()
    end
    return nil
end

